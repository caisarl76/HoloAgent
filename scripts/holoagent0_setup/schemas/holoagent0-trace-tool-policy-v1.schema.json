{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holoagent0.trace-tool-policy.v1",
  "type": "object",
  "required": ["$id", "schema_version", "digest_algorithm", "rows", "additionalProperties"],
  "properties": {
    "$id": {"const": "holoagent0.trace-tool-policy.v1"},
    "schema_version": {"const": "holoagent0.trace-tool-policy.v1"},
    "digest_algorithm": {"const": "sha256"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/row"}
    },
    "additionalProperties": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "nullableSha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "reviewState": {
      "type": "string",
      "enum": [
        "REVIEWED",
        "PENDING_REPRODUCIBLE_BUILD",
        "PENDING_IMPLEMENTATION_REVIEW"
      ]
    },
    "row": {
      "type": "object",
      "required": ["tool", "version", "platform", "syscall_abi", "source", "build", "runtime", "parser", "argv", "fixtures"],
      "properties": {
        "tool": {"const": "strace"},
        "version": {"const": "6.6"},
        "platform": {"const": "linux-x86_64"},
        "syscall_abi": {"const": "linux-x86_64"},
        "source": {
          "type": "object",
          "required": ["url", "size", "sha256"],
          "properties": {
            "url": {"const": "https://strace.io/files/6.6/strace-6.6.tar.xz"},
            "size": {"const": 2420364},
            "sha256": {"const": "421b4186c06b705163e64dc85f271ebdcf67660af8667283147d5e859fc8a96c"}
          },
          "additionalProperties": false
        },
        "build": {
          "type": "object",
          "required": ["recipe_path", "recipe_sha256", "container_image_digest", "digest_algorithm", "review_state"],
          "properties": {
            "recipe_path": {"type": "string", "minLength": 1},
            "recipe_sha256": {"$ref": "#/$defs/nullableSha256"},
            "container_image_digest": {
              "oneOf": [
                {"type": "null"},
                {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              ]
            },
            "digest_algorithm": {"const": "sha256"},
            "review_state": {"$ref": "#/$defs/reviewState"}
          },
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "required": ["elf_path", "elf_size", "elf_sha256", "version_output_sha256", "digest_algorithm", "review_state"],
          "properties": {
            "elf_path": {"type": "string", "minLength": 1},
            "elf_size": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
            "elf_sha256": {"$ref": "#/$defs/nullableSha256"},
            "version_output_sha256": {"$ref": "#/$defs/nullableSha256"},
            "digest_algorithm": {"const": "sha256"},
            "review_state": {"$ref": "#/$defs/reviewState"}
          },
          "additionalProperties": false
        },
        "parser": {
          "type": "object",
          "required": ["path", "sha256", "digest_algorithm", "review_state"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/nullableSha256"},
            "digest_algorithm": {"const": "sha256"},
            "review_state": {"$ref": "#/$defs/reviewState"}
          },
          "additionalProperties": false
        },
        "argv": {
          "type": "object",
          "required": ["options", "raw_syscalls", "decoded_address_syscalls", "environment", "canonical_sha256", "digest_algorithm", "review_state"],
          "properties": {
          "options": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "string"}},
            "raw_syscalls": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"type": "string"}},
            "decoded_address_syscalls": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
            "environment": {
              "type": "object",
              "required": ["LC_ALL", "TZ"],
              "properties": {"LC_ALL": {"const": "C"}, "TZ": {"const": "UTC"}},
              "additionalProperties": false
            },
            "canonical_sha256": {"$ref": "#/$defs/nullableSha256"},
            "digest_algorithm": {"const": "sha256"},
            "review_state": {"$ref": "#/$defs/reviewState"}
          },
          "additionalProperties": false
        },
        "fixtures": {
          "type": "object",
          "required": ["manifest_path", "manifest_sha256", "digest_algorithm", "review_state"],
          "properties": {
            "manifest_path": {"type": "string", "minLength": 1},
            "manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
            "digest_algorithm": {"const": "sha256"},
            "review_state": {"$ref": "#/$defs/reviewState"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
